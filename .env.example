# ---- JEV judgment layer (TypeSafe "System One" model) ----------------------
# Route is re-evaluated periodically. OpenRouter or direct. The offline rule
# judge is the comparator and needs no key.
JEV_API_KEY=
JEV_BASE_URL=https://api.typesafe.ai
JEV_MODEL=jev

# ---- HTTP cache & throttling ------------------------------------------------
# On-disk cache for keyless macro sources; GDELT allows one request every 5s.
CADENCE_CACHE_DIR=var/http-cache
CADENCE_HTTP_TIMEOUT=15
GDELT_MIN_INTERVAL=5
